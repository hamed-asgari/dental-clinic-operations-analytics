/// Folder containing the nine processed Power BI-ready CSV files.
expression ProcessedDataPath = "C:\Users\user\Hamed Projects\dental-clinic-operations-analytics\data\processed" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 5419878f-3044-463c-9fdf-3c5a4643d86d

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

expression fnLoadCsv =
		(fileName as text) as table =>
		let
		    Source = Csv.Document(
		        File.Contents(ProcessedDataPath & "\" & fileName),
		        [
		            Delimiter = ",",
		            Encoding = 65001,
		            QuoteStyle = QuoteStyle.Csv
		        ]
		    ),
		    PromotedHeaders = Table.PromoteHeaders(
		        Source,
		        [PromoteAllScalars = true]
		    )
		in
		    PromotedHeaders
	lineageTag: 4ca759ea-aecd-4fd9-a78a-6e2548fb2ddb

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

